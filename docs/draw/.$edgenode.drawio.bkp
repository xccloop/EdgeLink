          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_storage_decision" edge="1" parent="1" source="storage_init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" target="init_decision">
