  <diagram id="edgenode-tcp-call" name="TCP 调用细节（平铺索引）">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1400" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tcp_title" value="EdgeNode TCP 函数调用图：ESP-AT 单连接建连与当前发送边界" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="1320" height="50" as="geometry" /></mxCell>
        <mxCell id="tcp_legend" value="绿色：已实现的函数调用&#xa;红色虚线：当前未接入或明确返回失败&#xa;橙色：等待、超时或失败分支" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1840" y="25" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="tcp_lane_app" value="APP / Output-Tcp：调用者与 AT 顺序编排" style="swimlane;horizontal=1;startSize=34;fillColor=#E8F4F8;strokeColor=#6C8EBF;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="110" width="2300" height="180" as="geometry" /></mxCell>
        <mxCell id="tcp_main" value="main() / init_all()&#xa;当前不调用 tcp_init()&#xa;避免无配置时重复初始化 USART1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="tcp_lane_app"><mxGeometry x="120" y="55" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="tcp_caller" value="配置调用者（待接入）&#xa;tcp_config_struct&#xa;SSID / 密码 / Hub IP / 端口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="tcp_lane_app"><mxGeometry x="360" y="55" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="tcp_init_node" value="tcp_init(config)&#xa;校验空指针、空文本、端口&#xa;校验引号 / CR / LF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="tcp_lane_app"><mxGeometry x="600" y="45" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_fail_config" value="TCP_FAIL&#xa;打印配置错误&#xa;不初始化 ESP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#B85450;" vertex="1" parent="tcp_lane_app"><mxGeometry x="870" y="55" width="160" height="70" as="geometry" /></mxCell>
        <mxCell id="tcp_esp_init" value="esp12s_init()&#xa;配置 USART1、RBNE 中断&#xa;tcp_connected = FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_lane_app"><mxGeometry x="1100" y="45" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_lane_commands" value="AT 命令链：前一条成功才进入下一条" style="swimlane;horizontal=1;startSize=34;fillColor=#E8F5E9;strokeColor=#82B366;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="2300" height="180" as="geometry" /></mxCell>
        <mxCell id="tcp_at" value="AT&#xa;ESP_AT_TEST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_lane_commands"><mxGeometry x="120" y="55" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="tcp_mode" value="AT+CWMODE=1&#xa;Station 模式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_lane_commands"><mxGeometry x="340" y="55" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="tcp_join" value="snprintf() 组装&#xa;AT+CWJAP=&quot;SSID&quot;,&quot;PWD&quot;&#xa;50 s 超时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_lane_commands"><mxGeometry x="570" y="40" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="tcp_cifsr" value="AT+CIFSR&#xa;查询网络地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_lane_commands"><mxGeometry x="840" y="55" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="tcp_mux" value="AT+CIPMUX=0&#xa;单连接模式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_lane_commands"><mxGeometry x="1070" y="55" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="tcp_ipmode" value="AT+CIPMODE=0&#xa;普通发送模式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_lane_commands"><mxGeometry x="1300" y="55" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="tcp_start" value="snprintf() 组装&#xa;AT+CIPSTART=&quot;TCP&quot;,IP,port&#xa;需 CONNECT + OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_lane_commands"><mxGeometry x="1530" y="40" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="tcp_connected" value="tcp_connected = SUCCESS&#xa;tcp_init() 返回 SUCCESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="tcp_lane_commands"><mxGeometry x="1810" y="50" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="tcp_lane_wait" value="命令执行公共路径：阻塞等待，但 USART1 / SysTick 中断仍运行" style="swimlane;horizontal=1;startSize=34;fillColor=#FFF9E6;strokeColor=#D6B656;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="490" width="2300" height="180" as="geometry" /></mxCell>
        <mxCell id="tcp_cmd_wait" value="tcp_command_send_and_wait_ok()&#xa;esp12s_response_reset()&#xa;esp12s_cmd_send(command)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="tcp_lane_wait"><mxGeometry x="170" y="45" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_connect_wait" value="tcp_connect_start_and_wait()&#xa;reset + send CIPSTART&#xa;要求 CONNECT 和 OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="tcp_lane_wait"><mxGeometry x="490" y="45" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_wait" value="tcp_wait_response()&#xa;deadline = systick + timeout&#xa;循环取回应队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="tcp_lane_wait"><mxGeometry x="820" y="45" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_rsp" value="esp12s_response_get()&#xa;无完整回应：继续等待" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="tcp_lane_wait"><mxGeometry x="1110" y="55" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="tcp_decide" value="回应类型？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="tcp_lane_wait"><mxGeometry x="1390" y="40" width="140" height="90" as="geometry" /></mxCell>
        <mxCell id="tcp_wait_ok" value="普通命令：OK 即成功&#xa;CIPSTART：CONNECT + OK&#xa;否则持续等待" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_lane_wait"><mxGeometry x="1640" y="45" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_wait_fail" value="ERROR / FAIL / BUSY&#xa;CIPSTART 中 CLOSED&#xa;或超时 → TCP_FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#B85450;" vertex="1" parent="tcp_lane_wait"><mxGeometry x="1930" y="45" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_lane_irq" value="ESP12S BSP / USART1 中断：把逐字符串口数据归纳为回应事件" style="swimlane;horizontal=1;startSize=34;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="680" width="2300" height="180" as="geometry" /></mxCell>
        <mxCell id="tcp_usart_irq" value="USART1_IRQHandler()&#xa;RBNE 逐字符接收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="tcp_lane_irq"><mxGeometry x="220" y="55" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="tcp_parse_rsp" value="usart.c 私有解析&#xa;识别 OK / ERROR / FAIL&#xa;CONNECT / CLOSED / BUSY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="tcp_lane_irq"><mxGeometry x="520" y="45" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_queue" value="回应队列&#xa;防止 CONNECT 与 OK&#xa;连续到达时相互覆盖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="tcp_lane_irq"><mxGeometry x="870" y="45" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_ipd" value="+IPD TCP 负载&#xa;当前不混入 AT 回应&#xa;长度解析与接收缓冲待实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="tcp_lane_irq"><mxGeometry x="1260" y="45" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_lane_send" value="遥测发送支路：协议编码已完成，ESP-AT 载荷发送尚未接入" style="swimlane;horizontal=1;startSize=34;fillColor=#FCE4EC;strokeColor=#B85450;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="870" width="2300" height="180" as="geometry" /></mxCell>
        <mxCell id="tcp_service_gap" value="node_service_run_once()&#xa;当前仅调用 Storage&#xa;未调用 tcp_frame_transmit()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="tcp_lane_send"><mxGeometry x="160" y="45" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_transmit" value="tcp_frame_transmit(message, sequence)&#xa;待从 Service 接入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="tcp_lane_send"><mxGeometry x="510" y="55" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="tcp_encode" value="tcp_frame_encode(frame[16], ...)&#xa;EH / V4 / nodeId / sequence&#xa;温度、倍率、CRC32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_lane_send"><mxGeometry x="850" y="45" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_payload_gap" value="缺少 CIPSEND / 原始 16B 写入&#xa;未调用 esp12s_cmd_send()&#xa;函数当前固定返回 FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="tcp_lane_send"><mxGeometry x="1220" y="45" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="tcp_hub_gap" value="EdgeHub TCP 接收&#xa;当前此仓库未形成运行闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="tcp_lane_send"><mxGeometry x="1610" y="55" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="te1" edge="1" parent="1" source="tcp_main" target="tcp_caller" value="未接入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te2" edge="1" parent="1" source="tcp_caller" target="tcp_init_node" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te3" edge="1" parent="1" source="tcp_init_node" target="tcp_fail_config" value="非法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te4" edge="1" parent="1" source="tcp_init_node" target="tcp_esp_init" value="合法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te5" edge="1" parent="1" source="tcp_esp_init" target="tcp_at" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te6" edge="1" parent="1" source="tcp_at" target="tcp_mode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te7" edge="1" parent="1" source="tcp_mode" target="tcp_join" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te8" edge="1" parent="1" source="tcp_join" target="tcp_cifsr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te9" edge="1" parent="1" source="tcp_cifsr" target="tcp_mux" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te10" edge="1" parent="1" source="tcp_mux" target="tcp_ipmode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te11" edge="1" parent="1" source="tcp_ipmode" target="tcp_start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te12" edge="1" parent="1" source="tcp_start" target="tcp_connected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te13" edge="1" parent="1" source="tcp_at" target="tcp_cmd_wait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te14" edge="1" parent="1" source="tcp_start" target="tcp_connect_wait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te15" edge="1" parent="1" source="tcp_cmd_wait" target="tcp_wait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te16" edge="1" parent="1" source="tcp_connect_wait" target="tcp_wait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te17" edge="1" parent="1" source="tcp_wait" target="tcp_rsp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te18" edge="1" parent="1" source="tcp_rsp" target="tcp_decide" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te19" edge="1" parent="1" source="tcp_decide" target="tcp_wait_ok" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te20" edge="1" parent="1" source="tcp_decide" target="tcp_wait_fail" value="失败 / 超时" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te21" edge="1" parent="1" source="tcp_usart_irq" target="tcp_parse_rsp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te22" edge="1" parent="1" source="tcp_parse_rsp" target="tcp_queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te23" edge="1" parent="1" source="tcp_queue" target="tcp_rsp" value="取事件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te24" edge="1" parent="1" source="tcp_service_gap" target="tcp_transmit" value="待接入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te25" edge="1" parent="1" source="tcp_transmit" target="tcp_encode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te26" edge="1" parent="1" source="tcp_encode" target="tcp_payload_gap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="te27" edge="1" parent="1" source="tcp_payload_gap" target="tcp_hub_gap" value="未发生" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="edgenode-storage-call" name="Storage 调用细节（平铺索引）">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="st_title" value="EdgeNode Storage 函数调用图：GD25Q32 历史顺序追加、commit-last 与读回验证" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="390" y="20" width="1420" height="50" as="geometry" /></mxCell>
        <mxCell id="st_legend" value="绿色：当前已接入主流程&#xa;橙色：检查 / 保护 / 失败锁定&#xa;蓝色：SPI0 与 GD25Q32 BSP 边界&#xa;不回绕、不复用历史扇区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1840" y="20" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="st_lane_boot" value="启动恢复：只寻找完整擦除扇区；不在启动时擦除，不续写旧扇区" style="swimlane;horizontal=1;startSize=34;fillColor=#E8F5E9;strokeColor=#82B366;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="120" width="2300" height="180" as="geometry" /></mxCell>
        <mxCell id="st_main" value="main() → init_all()&#xa;BOARD / BSP 先完成&#xa;共享 SPI0 可用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="st_lane_boot"><mxGeometry x="120" y="45" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="st_init" value="storage_init()&#xa;storage_ready = 0&#xa;next = 0x000000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="st_lane_boot"><mxGeometry x="400" y="45" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="st_gdinit" value="gd25_init()&#xa;PB12 CS 安全初始化&#xa;0x9F 读取 JEDEC ID&#xa;仅 C8 40 16 才 ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="st_lane_boot"><mxGeometry x="690" y="35" width="210" height="100" as="geometry" /></mxCell>
        <mxCell id="st_sector_loop" value="for 0x000000 → 0x3FFFFF&#xa;步长 4 KiB&#xa;storage_sector_is_erased(address)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="st_lane_boot"><mxGeometry x="1030" y="45" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="st_scan" value="每槽 16 B：gd25_read()&#xa;逐字节确认全为 0xFF&#xa;避免擦除中掉电的混合扇区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="st_lane_boot"><mxGeometry x="1370" y="35" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="st_ready" value="发现完整空扇区&#xa;保存 storage_next_address&#xa;storage_ready = 1&#xa;返回 SUCCESS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="st_lane_boot"><mxGeometry x="1730" y="35" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="st_boot_fail" value="ID 错误、读取失败&#xa;或无完整空扇区&#xa;返回 FAIL → init_all 失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#B85450;" vertex="1" parent="st_lane_boot"><mxGeometry x="2010" y="45" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="st_lane_runtime" value="周期业务：当前唯一已接入的 Message 输出分支" style="swimlane;horizontal=1;startSize=34;fillColor=#E8F4F8;strokeColor=#6C8EBF;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="310" width="2300" height="180" as="geometry" /></mxCell>
        <mxCell id="st_service" value="node_service_run_once()&#xa;1000 ms 周期门控" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="st_lane_runtime"><mxGeometry x="120" y="55" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="st_collect" value="message_collect()&#xa;collection_temperature_get()&#xa;构建 telemetry_sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="st_lane_runtime"><mxGeometry x="410" y="45" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="st_temperature" value="storage_temperature(message)&#xa;公开保存入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="st_lane_runtime"><mxGeometry x="750" y="55" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="st_guard" value="storage_ready？ message 非空？&#xa;next ≤ 4 MiB - 16？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="st_lane_runtime"><mxGeometry x="1080" y="40" width="160" height="90" as="geometry" /></mxCell>
        <mxCell id="st_runtime_fail" value="FAIL&#xa;拒绝野指针 / 未初始化&#xa;容量满时 ready = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#B85450;" vertex="1" parent="st_lane_runtime"><mxGeometry x="1370" y="45" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="st_lane_write" value="写入 16 字节槽位：先载荷+CRC，最后 commit，再读回验证" style="swimlane;horizontal=1;startSize=34;fillColor=#FFF9E6;strokeColor=#D6B656;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="2300" height="180" as="geometry" /></mxCell>
        <mxCell id="st_erase_gate" value="next % 4 KiB == 0？&#xa;是：该扇区首次写入" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="st_lane_write"><mxGeometry x="140" y="40" width="160" height="90" as="geometry" /></mxCell>
        <mxCell id="st_erase" value="gd25_clear(next)&#xa;0x20 扇区擦除&#xa;仅当前新扇区一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="st_lane_write"><mxGeometry x="410" y="45" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="st_encode" value="storage_record_encode()&#xa;message_encode()：9 B 载荷&#xa;crc32_generate()：4 B CRC&#xa;commit 保持 FF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="st_lane_write"><mxGeometry x="700" y="35" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="st_write_data" value="gd25_write(next, data, 13)&#xa;写载荷 + CRC&#xa;不跨 256 B 页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="st_lane_write"><mxGeometry x="1040" y="45" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="st_write_commit" value="gd25_write(next + 15, 0x00, 1)&#xa;commit-last&#xa;掉电的未提交记录无效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="st_lane_write"><mxGeometry x="1360" y="45" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="st_verify" value="storage_record_verify()&#xa;gd25_read(16 B)&#xa;比对 0..12、commit=0&#xa;crc32_check()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="st_lane_write"><mxGeometry x="1720" y="35" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="st_lock" value="擦除 / 写 / commit / 校验&#xa;任一步失败：ready = 0&#xa;本次启动不再写该槽位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="st_lane_write"><mxGeometry x="2040" y="35" width="210" height="100" as="geometry" /></mxCell>
        <mxCell id="st_lane_bsp" value="GD25Q32 BSP 与共享 SPI0：每个公开读/写/擦都先守住设备状态与时序" style="swimlane;horizontal=1;startSize=34;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="690" width="2300" height="180" as="geometry" /></mxCell>
        <mxCell id="st_gdread" value="gd25_read()&#xa;ready / 地址 / 长度检查&#xa;gd25_wait_busy()&#xa;0x03 + 24-bit 地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="st_lane_bsp"><mxGeometry x="120" y="35" width="205" height="100" as="geometry" /></mxCell>
        <mxCell id="st_gdwrite" value="gd25_write()&#xa;ready / 页边界检查&#xa;wait_busy() → write_enable()&#xa;0x02 + 地址 + 数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="st_lane_bsp"><mxGeometry x="450" y="35" width="215" height="100" as="geometry" /></mxCell>
        <mxCell id="st_gdclear" value="gd25_clear()&#xa;扇区地址对齐检查&#xa;wait_busy() → write_enable()&#xa;0x20 + 地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="st_lane_bsp"><mxGeometry x="790" y="35" width="215" height="100" as="geometry" /></mxCell>
        <mxCell id="st_wel" value="gd25_write_enable()&#xa;0x06 → 0x05&#xa;确认 WEL = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="st_lane_bsp"><mxGeometry x="1140" y="45" width="180" height="80" as="geometry" /></mxCell>
        <mxCell id="st_wip" value="gd25_wait_busy()&#xa;反复 0x05 查询 WIP&#xa;500 ms 与轮询上限保护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="st_lane_bsp"><mxGeometry x="1450" y="45" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="st_spi" value="gd25_cs_select/release()&#xa;spi0_tansfer_data()&#xa;spi0_bus_wait_idle()&#xa;SPI0：PA5 / PA6 / PA7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="st_lane_bsp"><mxGeometry x="1780" y="35" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="st_chip" value="GD25Q32 4 MiB NOR Flash&#xa;256 B 页 / 4 KiB 扇区&#xa;PB12 片选" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="st_lane_bsp"><mxGeometry x="2100" y="45" width="150" height="80" as="geometry" /></mxCell>
        <mxCell id="st_lane_advance" value="成功后的地址推进与容量语义：从 0x00 起一直向下写，不隐式回绕或回收" style="swimlane;horizontal=1;startSize=34;fillColor=#FCE4EC;strokeColor=#B85450;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="880" width="2300" height="150" as="geometry" /></mxCell>
        <mxCell id="st_advance" value="校验成功后&#xa;非末槽：next += 16&#xa;下一记录继续同扇区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="st_lane_advance"><mxGeometry x="420" y="45" width="210" height="70" as="geometry" /></mxCell>
        <mxCell id="st_last" value="最后一个槽位写完&#xa;next = 0x400000&#xa;ready = 0&#xa;不回绕覆盖历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="st_lane_advance"><mxGeometry x="830" y="35" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="st_next_get" value="storage_next_address_get()&#xa;仅返回 RAM 中本次地址&#xa;不读 Flash、不改变状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="st_lane_advance"><mxGeometry x="1240" y="45" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="se1" edge="1" parent="1" source="st_main" target="st_init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se2" edge="1" parent="1" source="st_init" target="st_gdinit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se3" edge="1" parent="1" source="st_gdinit" target="st_sector_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se4" edge="1" parent="1" source="st_sector_loop" target="st_scan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se5" edge="1" parent="1" source="st_scan" target="st_ready" value="全 FF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se6" edge="1" parent="1" source="st_gdinit" target="st_boot_fail" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se7" edge="1" parent="1" source="st_sector_loop" target="st_boot_fail" value="耗尽" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se8" edge="1" parent="1" source="st_service" target="st_collect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se9" edge="1" parent="1" source="st_collect" target="st_temperature" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se10" edge="1" parent="1" source="st_temperature" target="st_guard" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se11" edge="1" parent="1" source="st_guard" target="st_runtime_fail" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se12" edge="1" parent="1" source="st_guard" target="st_erase_gate" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se13" edge="1" parent="1" source="st_erase_gate" target="st_erase" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se14" edge="1" parent="1" source="st_erase" target="st_encode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se15" edge="1" parent="1" source="st_erase_gate" target="st_encode" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se16" edge="1" parent="1" source="st_encode" target="st_write_data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se17" edge="1" parent="1" source="st_write_data" target="st_write_commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se18" edge="1" parent="1" source="st_write_commit" target="st_verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se19" edge="1" parent="1" source="st_erase" target="st_lock" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se20" edge="1" parent="1" source="st_write_data" target="st_lock" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se21" edge="1" parent="1" source="st_write_commit" target="st_lock" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se22" edge="1" parent="1" source="st_verify" target="st_lock" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se23" edge="1" parent="1" source="st_write_data" target="st_gdwrite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se24" edge="1" parent="1" source="st_write_commit" target="st_gdwrite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se25" edge="1" parent="1" source="st_erase" target="st_gdclear" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se26" edge="1" parent="1" source="st_verify" target="st_gdread" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se27" edge="1" parent="1" source="st_scan" target="st_gdread" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se28" edge="1" parent="1" source="st_gdwrite" target="st_wip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se29" edge="1" parent="1" source="st_gdwrite" target="st_wel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se30" edge="1" parent="1" source="st_gdclear" target="st_wip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se31" edge="1" parent="1" source="st_gdclear" target="st_wel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se32" edge="1" parent="1" source="st_gdread" target="st_spi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se33" edge="1" parent="1" source="st_gdwrite" target="st_spi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se34" edge="1" parent="1" source="st_gdclear" target="st_spi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se35" edge="1" parent="1" source="st_spi" target="st_chip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se36" edge="1" parent="1" source="st_verify" target="st_advance" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se37" edge="1" parent="1" source="st_advance" target="st_last" value="末槽" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se38" edge="1" parent="1" source="st_advance" target="st_next_get" value="观察" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="edgenode-tcp-tree" name="TCP：流程树 + 调用树">
    <mxGraphModel dx="2100" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="tt_title" value="TCP：业务流程树 与 代码函数调用树" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="550" y="20" width="1000" height="45" as="geometry" /></mxCell>
        <mxCell id="tt_note" value="上半不写代码：解释一条数据如何到达 EdgeHub。下半只写函数：解释源码当前如何协作。&#xa;红色虚线表示当前尚未接入，不代表已完成链路。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1450" y="20" width="570" height="60" as="geometry" /></mxCell>
        <mxCell id="tt_flow_box" value="① 业务流程树（不包含函数名）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4F8;strokeColor=#6C8EBF;fontStyle=1;fontSize=17;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="2040" height="360" as="geometry" /></mxCell>
        <mxCell id="tt_flow_root" value="EdgeNode 温度上报&#xa;目标：GD32 → Wi-Fi → TCP → EdgeHub" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="tt_flow_sample" value="1. 产生遥测数据&#xa;BMP280 温度 + 倍率&#xa;形成统一 Message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="410" y="150" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="tt_flow_encode" value="2. 编码为固定 TCP V4 帧&#xa;16 B：帧头、节点、序号、温度、CRC32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="710" y="150" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="tt_flow_join" value="A. 建立链路&#xa;ESP-12S 加入 Wi-Fi&#xa;与 Hub:port 建立单 TCP 连接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="410" y="310" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="tt_flow_send" value="3. 请求发送长度&#xa;ESP-AT CIPSEND&#xa;再写入原始 16 B 帧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="tt_flow_network" value="4. 局域网 TCP 字节流&#xa;无消息边界&#xa;断线后需要恢复策略" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1380" y="150" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="tt_flow_hub" value="5. EdgeHub&#xa;缓冲、完整帧校验、解析&#xa;持久化与查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1680" y="150" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="tt_flow_fail" value="失败分支&#xa;配置非法 / AT ERROR / BUSY / 超时 / CLOSED&#xa;当前 tcp_init() 立即返回失败；未实现重连服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1050" y="310" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="tt_code_box" value="② 函数调用树（只描述当前源码真实调用与缺口）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontStyle=1;fontSize=17;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="2040" height="590" as="geometry" /></mxCell>
        <mxCell id="tt_code_root" value="TCP 模块" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="760" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="tt_code_entry" value="tcp_init(config)&#xa;当前：没有 main / init_all 调用者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="600" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="tt_code_valid" value="tcp_at_text_valid()&#xa;拒绝引号、CR、LF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="730" y="550" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="tt_code_esp" value="esp12s_init()&#xa;配置 USART1 + RBNE IRQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="730" y="650" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="tt_code_cmd" value="tcp_command_send_and_wait_ok()&#xa;AT / CWMODE / CWJAP / CIFSR / CIPMUX / CIPMODE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="730" y="750" width="250" height="70" as="geometry" /></mxCell>
        <mxCell id="tt_code_connect" value="tcp_connect_start_and_wait()&#xa;CIPSTART 专用&#xa;要求 CONNECT + OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="730" y="860" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="tt_code_sendcmd" value="esp12s_response_reset()&#xa;esp12s_cmd_send()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1080" y="720" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="tt_code_wait" value="tcp_wait_response()&#xa;超时循环取回应&#xa;成功：OK 或 CONNECT+OK&#xa;失败：ERROR / FAIL / BUSY / CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="830" width="240" height="100" as="geometry" /></mxCell>
        <mxCell id="tt_code_irq" value="USART1_IRQHandler()&#xa;usart.c 私有解析&#xa;回应队列 → esp12s_response_get()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1450" y="830" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="tt_code_tx" value="tcp_frame_transmit()&#xa;tcp_frame_encode(frame[16], ...)&#xa;当前没有调用 ESP 发送，固定返回 FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="970" width="270" height="70" as="geometry" /></mxCell>
        <mxCell id="tte1" edge="1" parent="1" source="tt_flow_root" target="tt_flow_sample" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte2" edge="1" parent="1" source="tt_flow_sample" target="tt_flow_encode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte3" edge="1" parent="1" source="tt_flow_root" target="tt_flow_join" value="并行准备" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte4" edge="1" parent="1" source="tt_flow_encode" target="tt_flow_send" value="待补齐" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte5" edge="1" parent="1" source="tt_flow_join" target="tt_flow_send" value="连接成功后" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte6" edge="1" parent="1" source="tt_flow_send" target="tt_flow_network" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte7" edge="1" parent="1" source="tt_flow_network" target="tt_flow_hub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte8" edge="1" parent="1" source="tt_flow_join" target="tt_flow_fail" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte9" edge="1" parent="1" source="tt_code_root" target="tt_code_entry" value="初始化树" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;dashed=1;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte10" edge="1" parent="1" source="tt_code_entry" target="tt_code_valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte11" edge="1" parent="1" source="tt_code_entry" target="tt_code_esp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte12" edge="1" parent="1" source="tt_code_entry" target="tt_code_cmd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte13" edge="1" parent="1" source="tt_code_entry" target="tt_code_connect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte14" edge="1" parent="1" source="tt_code_cmd" target="tt_code_sendcmd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte15" edge="1" parent="1" source="tt_code_sendcmd" target="tt_code_wait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte16" edge="1" parent="1" source="tt_code_connect" target="tt_code_wait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte17" edge="1" parent="1" source="tt_code_irq" target="tt_code_wait" value="回应事件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="tte18" edge="1" parent="1" source="tt_code_root" target="tt_code_tx" value="发送树（未接入）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="edgenode-storage-tree" name="Storage：流程树 + 调用树">
    <mxGraphModel dx="2100" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="stt_title" value="Storage：业务流程树 与 代码函数调用树" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="500" y="20" width="1100" height="45" as="geometry" /></mxCell>
        <mxCell id="stt_note" value="上半讲“一条温度历史为何可信”；下半讲“Storage 与 GD25Q32 函数怎么工作”。&#xa;绿色为主链已接入；红色为故障后的保护性停止，而不是自动重试。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1440" y="20" width="580" height="60" as="geometry" /></mxCell>
        <mxCell id="stt_flow_box" value="① 业务流程树（不包含函数名）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4F8;strokeColor=#6C8EBF;fontStyle=1;fontSize=17;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="2040" height="360" as="geometry" /></mxCell>
        <mxCell id="stt_flow_root" value="温度历史记录&#xa;从 0x000000 起&#xa;顺序追加" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="stt_flow_boot" value="A. 上电恢复&#xa;确认芯片身份&#xa;只找“整扇区全 FF”的新位置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="200" height="80" as="geometry" /></mxCell>
        <mxCell id="stt_flow_abandon" value="旧的未满扇区不续写&#xa;擦除中掉电造成的未知区域也放弃&#xa;以少量容量换恢复安全" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="720" y="150" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="stt_flow_sample" value="B. 每秒产生一条&#xa;温度、倍率、采样时刻" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="400" y="310" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="stt_flow_slot" value="1. 准备 16 B 槽位&#xa;9 B 载荷 + 4 B CRC32&#xa;commit 保持 FF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="stt_flow_erase" value="2. 新 4 KiB 扇区首次写入前擦除&#xa;同扇区的后续 256 条不重复擦除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1060" y="300" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="stt_flow_commit" value="3. 先写载荷+CRC&#xa;最后写 commit=0x00&#xa;未提交槽位不算有效记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1400" y="150" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="stt_flow_verify" value="4. 整槽读回&#xa;逐字节比对 + commit + CRC32 校验&#xa;成功才前移 16 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1720" y="150" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="stt_flow_fail" value="失败保护&#xa;擦除 / 写 / commit / 校验任一失败&#xa;本次启动锁定 Storage，不原地重试&#xa;容量满也不回绕覆盖历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="310" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="stt_code_box" value="② 函数调用树（只描述当前源码真实调用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontStyle=1;fontSize=17;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="30" y="500" width="2040" height="590" as="geometry" /></mxCell>
        <mxCell id="stt_code_root" value="Storage 模块" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="760" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="stt_code_init" value="init_all() → storage_init()&#xa;启动初始化树" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="590" width="210" height="70" as="geometry" /></mxCell>
        <mxCell id="stt_code_gdinit" value="gd25_init()&#xa;CS 初始化 → 0x9F → ID=C84016&#xa;通过后 gd25_ready=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="730" y="540" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="stt_code_scan" value="storage_sector_is_erased()&#xa;循环 gd25_read(16 B)&#xa;确认 4 KiB 每字节 FF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="730" y="660" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="stt_code_runtime" value="node_service_run_once()&#xa;message_collect()&#xa;→ storage_temperature(message)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="860" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="stt_code_encode" value="storage_record_encode()&#xa;message_encode() + crc32_generate()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="730" y="840" width="210" height="70" as="geometry" /></mxCell>
        <mxCell id="stt_code_write" value="gd25_clear()（扇区边界）&#xa;gd25_write(13 B)&#xa;gd25_write(commit 1 B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1050" y="830" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="stt_code_verify" value="storage_record_verify()&#xa;gd25_read(16 B)&#xa;crc32_check()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1380" y="840" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="stt_code_bsp" value="GD25Q32 BSP&#xa;gd25_wait_busy() / write_enable()&#xa;CS + spi0_tansfer_data() + wait_idle()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1690" y="780" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="stt_code_lock" value="任何失败：storage_ready=0&#xa;成功：next += 16&#xa;末槽：next=4MiB 且 ready=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1690" y="940" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="stte1" edge="1" parent="1" source="stt_flow_root" target="stt_flow_boot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte2" edge="1" parent="1" source="stt_flow_boot" target="stt_flow_abandon" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte3" edge="1" parent="1" source="stt_flow_root" target="stt_flow_sample" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte4" edge="1" parent="1" source="stt_flow_sample" target="stt_flow_slot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte5" edge="1" parent="1" source="stt_flow_slot" target="stt_flow_erase" value="新扇区时" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte6" edge="1" parent="1" source="stt_flow_slot" target="stt_flow_commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte7" edge="1" parent="1" source="stt_flow_erase" target="stt_flow_commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte8" edge="1" parent="1" source="stt_flow_commit" target="stt_flow_verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte9" edge="1" parent="1" source="stt_flow_erase" target="stt_flow_fail" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte10" edge="1" parent="1" source="stt_flow_commit" target="stt_flow_fail" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte11" edge="1" parent="1" source="stt_flow_verify" target="stt_flow_fail" value="失败或满" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte12" edge="1" parent="1" source="stt_code_root" target="stt_code_init" value="初始化树" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte13" edge="1" parent="1" source="stt_code_init" target="stt_code_gdinit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte14" edge="1" parent="1" source="stt_code_init" target="stt_code_scan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stte15" edge="1" parent="1" source="stt_code_root" target="stt_code_runtime" value="记录树" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;"><mxGeometry relative="1" as="geometry" /></mxCell>
