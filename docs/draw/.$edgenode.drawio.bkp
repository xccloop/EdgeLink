          <mxGeometry height="180" width="180" x="720" y="470" as="geometry" />
        </mxCell>
        <mxCell id="startup_group" parent="1" style="swimlane;startSize=32;rounded=1;fillColor=#E8F5E9;strokeColor=#82B366;fontStyle=1;fontSize=15;html=1;" value="1. 启动与硬件基础" vertex="1">
