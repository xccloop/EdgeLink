          <mxGeometry height="60" width="150" x="210" y="55" as="geometry" />
        </mxCell>
        <mxCell id="board_init" parent="startup_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="BOARD 最先初始化&#xA;时钟 / NVIC / SysTick / SWD / SPI0" vertex="1">
