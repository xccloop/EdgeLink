        <mxCell id="e_bsp_storage_init" edge="1" parent="startup_group" source="bsp_init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" target="storage_init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="init_decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" value="全部成功？" vertex="1">
