        <mxCell id="outputs_group" parent="1" style="swimlane;startSize=32;rounded=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontStyle=1;fontSize=15;html=1;" value="3. Message 输出分支" vertex="1">
          <mxGeometry height="350" width="980" x="650" y="720" as="geometry" />
        </mxCell>
        <mxCell id="storage_output" parent="outputs_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" value="&lt;b&gt;Flash Storage（已接入）&lt;/b&gt;&#xA;16 字节槽位顺序追加&#xA;载荷 + CRC32 + commit&#xA;写后读回验证" vertex="1">
          <mxGeometry height="120" width="190" x="30" y="75" as="geometry" />
        </mxCell>
        <mxCell id="tcp_encode" parent="outputs_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="TCP V4 帧编码（已有）&#xA;固定 16 字节&#xA;EH / node_id / sequence&#xA;temperature / CRC32" vertex="1">
          <mxGeometry height="130" width="190" x="270" y="65" as="geometry" />
        </mxCell>
        <mxCell id="tcp_output" parent="outputs_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" value="ESP-AT / TCP 输出&#xA;tcp_init() 已实现但未由 init_all 调用&#xA;Transmit 尚未把帧交给 ESP12S" vertex="1">
          <mxGeometry height="130" width="200" x="510" y="65" as="geometry" />
        </mxCell>
        <mxCell id="can_encode" parent="outputs_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="CAN 帧编码 + Output（已有）&#xA;ID = 0x200 + node_id&#xA;7 字节遥测负载" vertex="1">
          <mxGeometry height="110" width="185" x="760" y="65" as="geometry" />
        </mxCell>
        <mxCell id="transmit_gap" parent="outputs_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" value="Service/Transmit 接入待完成&#xA;当前 node_service 只调用 Storage&#xA;TCP / CAN 不报告发送成功" vertex="1">
          <mxGeometry height="80" width="400" x="290" y="235" as="geometry" />
        </mxCell>
        <mxCell id="e_tcp_output" edge="1" parent="outputs_group" source="tcp_encode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;dashed=1;endArrow=classic;" target="tcp_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tcp_gap" edge="1" parent="outputs_group" source="tcp_output" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;dashed=1;endArrow=classic;" target="transmit_gap">
          <mxGeometry relative="1" as="geometry" />
