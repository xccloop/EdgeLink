          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="display_group" parent="1" style="swimlane;startSize=32;rounded=1;fillColor=#FCE4EC;strokeColor=#B85450;fontStyle=1;fontSize=15;html=1;" value="4. 显示支撑（尚未进入业务显示）" vertex="1">
