        </mxCell>
        <mxCell id="ips" parent="display_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="IPS BSP&#xA;ST7789 / SPI2 / DMA" vertex="1">
          <mxGeometry height="75" width="145" x="35" y="70" as="geometry" />
        </mxCell>
        <mxCell id="double_buffer" parent="display_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="APP 双行缓冲&#xA;FREE → READY → TRANSMITTING" vertex="1">
