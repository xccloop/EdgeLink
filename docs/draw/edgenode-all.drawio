        <mxCell id="hmi_gap" parent="display_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" value="HMI / 遥测数据显示&#xA;当前 main 未调用渲染服务" vertex="1">
