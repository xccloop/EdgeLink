  <diagram id="edgenode-detail" name="细分展开">
    <mxGraphModel dx="1201" dy="828" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1450" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" value="EdgeNode 细分展开：从上电、采样到每一个输出边界" vertex="1">
          <mxGeometry height="45" width="940" x="530" y="20" as="geometry" />
        </mxCell>
        <mxCell id="d_boot_group" parent="1" style="swimlane;startSize=34;rounded=1;fillColor=#E8F5E9;strokeColor=#82B366;fontStyle=1;fontSize=16;html=1;" value="1. 上电与初始化：只做资源准备，不做周期业务" vertex="1">
          <mxGeometry height="680" width="440" x="20" y="90" as="geometry" />
        </mxCell>
        <mxCell id="d_main" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" value="&lt;b&gt;main()&lt;/b&gt;&#xa;调用 init_all()&#xa;失败后停在 while(1)" vertex="1">
          <mxGeometry height="80" width="160" x="55" y="150" as="geometry" />
        </mxCell>
        <mxCell id="d_board" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" value="&lt;b&gt;board_config_init() 最先执行&lt;/b&gt;&#xa;时钟与 SysTick 毫秒计时&#xa;NVIC 与 SWD&#xa;共享 SPI0 总线" vertex="1">
          <mxGeometry height="115" width="170" x="260" y="130" as="geometry" />
        </mxCell>
        <mxCell id="d_basic_bsp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;无返回状态的 BSP&lt;/b&gt;&#xa;CH340、LED、KEY、ADC&#xa;只完成外设本地准备" vertex="1">
          <mxGeometry height="100" width="170" x="55" y="300" as="geometry" />
        </mxCell>
        <mxCell id="d_checked_bsp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;需要检查结果的初始化&lt;/b&gt;&#xa;Can_init()&#xa;bmp280_init()&#xa;ips_init() 与 display_buffer_init()&#xa;storage_init()" vertex="1">
          <mxGeometry height="135" width="180" x="250" y="285" as="geometry" />
        </mxCell>
        <mxCell id="d_init_result" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7F1D1D;" value="任一步失败&#xa;返回 INIT_ALL_FAIL&#xa;main 不进入业务循环" vertex="1">
          <mxGeometry height="90" width="200" x="130" y="470" as="geometry" />
        </mxCell>
        <mxCell id="d_tcp_excluded" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;TCP 不在 init_all() 中&lt;/b&gt;&#xa;tcp_init() 需要 WiFi 与服务器配置&#xa;它自己会初始化 ESP12S&#xa;避免 USART1 重复初始化" vertex="1">
          <mxGeometry height="95" width="320" x="75" y="605" as="geometry" />
        </mxCell>
        <mxCell id="d_service_group" parent="1" style="swimlane;startSize=34;rounded=1;fillColor=#E8F4F8;strokeColor=#6C8EBF;fontStyle=1;fontSize=16;html=1;" value="2. 采样调度：Service 决定何时产生一条 Message" vertex="1">
          <mxGeometry height="680" width="520" x="480" y="90" as="geometry" />
        </mxCell>
        <mxCell id="d_loop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" value="&lt;b&gt;while(1)&lt;/b&gt;&#xa;启动提示&#xa;LED1 与 LED2 翻转&#xa;调用 node_service_run_once()" vertex="1">
          <mxGeometry height="105" width="185" x="515" y="140" as="geometry" />
        </mxCell>
        <mxCell id="d_time_gate" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;时间门&lt;/b&gt;&#xa;读取 board_systick_ms&#xa;now - last &lt; 1000 ms&#xa;直接返回，不采样不写 Flash" vertex="1">
          <mxGeometry height="125" width="195" x="750" y="130" as="geometry" />
        </mxCell>
        <mxCell id="d_sample_mark" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" value="&lt;b&gt;到期后先记录本轮时刻&lt;/b&gt;&#xa;即使随后采样或存储失败&#xa;也不会在紧循环内无限重试" vertex="1">
          <mxGeometry height="100" width="210" x="550" y="315" as="geometry" />
        </mxCell>
        <mxCell id="d_collect" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;message_collect()&lt;/b&gt;&#xa;委托 Acquisition/Collection&#xa;读取 BMP280" vertex="1">
          <mxGeometry height="85" width="165" x="800" y="330" as="geometry" />
        </mxCell>
        <mxCell id="d_model" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontStyle=1;" value="&lt;b&gt;telemetry_sample_struct&lt;/b&gt;&#xa;temperature：int32&#xa;temperature_scale：int8&#xa;sample_uptime_ms：uint32&#xa;只表达数据，不知道去向" vertex="1">
          <mxGeometry height="130" width="285" x="590" y="480" as="geometry" />
        </mxCell>
        <mxCell id="d_service_result" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="返回值&#xa;1：本轮无须采样或存储成功&#xa;0：采样失败或 Storage 失败&#xa;main 当前未展示该状态" vertex="1">
          <mxGeometry height="75" width="360" x="530" y="650" as="geometry" />
        </mxCell>
        <mxCell id="d_output_group" parent="1" style="swimlane;startSize=34;rounded=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontStyle=1;fontSize=16;html=1;" value="3. 输出边界：同一条 Message 可以被独立消费" vertex="1">
          <mxGeometry height="680" width="940" x="1020" y="90" as="geometry" />
        </mxCell>
        <mxCell id="d_can_output" parent="d_output_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;Output/Can：已有&lt;/b&gt;&#xa;can_telemetry_send()&#xa;CAN ID = 0x200 + node_id&#xa;调用 can0_data_send() 请求邮箱&#xa;缺口：Service 提供 node_id 与 sequence 并接入" vertex="1">
          <mxGeometry height="140" width="280" x="410" y="370" as="geometry" />
        </mxCell>
        <mxCell id="d_tcp_output" parent="d_output_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" value="&lt;b&gt;Output/Tcp：连接已有，发送待补&lt;/b&gt;&#xa;tcp_init()：AT 测试、入网、CIPSTART&#xa;tcp_connected_get()：连接状态&#xa;缺口：CIPSEND 数据发送、重连、Service 接入" vertex="1">
          <mxGeometry height="135" width="320" x="440" y="200" as="geometry" />
        </mxCell>
        <mxCell id="d_no_false_success" parent="d_output_group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" value="&lt;b&gt;当前禁止伪报成功&lt;/b&gt;&#xa;Transmit 的 TCP/CAN 函数在真实发送未完成前返回 FAIL&#xa;待接入能力不等于已经工作" vertex="1">
          <mxGeometry height="80" width="630" x="150" y="555" as="geometry" />
        </mxCell>
        <mxCell id="d_fanout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" value="&lt;b&gt;Service 的扇出策略&lt;/b&gt;&#xa;当前：仅调用 Storage&#xa;未来：同一 Message 再交 TCP 与 CAN&#xa;各输出应独立报告成功或失败" vertex="1">
          <mxGeometry height="110" width="230" x="1050" y="140" as="geometry" />
        </mxCell>
        <mxCell id="d_storage" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" value="&lt;b&gt;Storage：当前已接入&lt;/b&gt;&#xa;storage_temperature(message)&#xa;只追加，不把地址策略交给 main" vertex="1">
          <mxGeometry height="95" width="240" x="1330" y="130" as="geometry" />
        </mxCell>
        <mxCell id="d_tcp_protocol" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;Protocol/Tcp：已有&lt;/b&gt;&#xa;tcp_frame_encode()&#xa;V4 固定 16 字节&#xa;EH、版本、source、target、序号&#xa;温度、倍率、CRC32" vertex="1">
          <mxGeometry height="135" width="300" x="1620" y="115" as="geometry" />
        </mxCell>
        <mxCell id="d_can_protocol" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;Protocol/Can：已有&lt;/b&gt;&#xa;can_frame_encode() 只填充数据&#xa;[sequence 2][temperature 4][scale 1]&#xa;不直接访问 CAN BSP" vertex="1">
          <mxGeometry height="120" width="280" x="1055" y="385" as="geometry" />
        </mxCell>
        <mxCell id="d_reliability_group" parent="1" style="swimlane;startSize=34;rounded=1;fillColor=#FCE4EC;strokeColor=#B85450;fontStyle=1;fontSize=16;html=1;" value="4. Flash 可靠性与显示边界" vertex="1">
          <mxGeometry height="500" width="1940" x="20" y="810" as="geometry" />
        </mxCell>
        <mxCell id="d_slot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="&lt;b&gt;Flash 槽位：16 字节&lt;/b&gt;&#xa;0 到 3：sample_uptime_ms 大端&#xa;4 到 7：temperature 大端补码&#xa;8：temperature_scale&#xa;9 到 12：前 9 字节 CRC32&#xa;13 到 14：预留 FF&#xa;15：commit" vertex="1">
          <mxGeometry height="200" width="280" x="55" y="875" as="geometry" />
        </mxCell>
        <mxCell id="d_write_order" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" value="&lt;b&gt;一次写入事务&lt;/b&gt;&#xa;1. 新扇区先擦除 4 KiB&#xa;2. 写 9 字节载荷加 4 字节 CRC&#xa;3. 最后单独写 commit = 0x00&#xa;4. 读回比对载荷、commit、CRC" vertex="1">
          <mxGeometry height="175" width="310" x="385" y="875" as="geometry" />
        </mxCell>
        <mxCell id="d_power_loss" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;掉电保护语义&lt;/b&gt;&#xa;commit 保持 FF：这条记录不可信&#xa;CRC 不匹配：这条记录不可信&#xa;擦除期间掉电：启动时只选整扇区全 FF 的新区域&#xa;代价：未写满旧扇区的剩余槽位被放弃" vertex="1">
          <mxGeometry height="200" width="390" x="750" y="865" as="geometry" />
        </mxCell>
        <mxCell id="d_capacity" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="&lt;b&gt;容量与停止条件&lt;/b&gt;&#xa;4 MiB，从 0x000000 顺序追加&#xa;每扇区 4 KiB = 256 个槽位&#xa;写至末尾不回绕，防止覆盖历史&#xa;写入或验证失败：storage_ready 清零" vertex="1">
          <mxGeometry height="175" width="300" x="1190" y="875" as="geometry" />
        </mxCell>
        <mxCell id="d_display" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" value="&lt;b&gt;Presentation：当前未接入 Service&lt;/b&gt;&#xa;IPS BSP：ST7789、SPI2、DMA&#xa;Buffer：FREE 到 READY 到 TRANSMITTING&#xa;未来 HMI 只消费 Message 与系统状态&#xa;HMI 不直接读取 BMP280、Flash 或 TCP" vertex="1">
          <mxGeometry height="175" width="370" x="1540" y="875" as="geometry" />
        </mxCell>
        <mxCell id="d_verify" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" value="&lt;b&gt;验证边界&lt;/b&gt;&#xa;当前：clean build 已生成 ELF 与 BIN&#xa;未证明：Flash 掉电、CAN 总线、TCP 上报、IPS 显示、端到端链路&#xa;编译成功不等于硬件与现场运行成功" vertex="1">
          <mxGeometry height="100" width="800" x="600" y="1135" as="geometry" />
        </mxCell>
        <mxCell id="de_main_board" edge="1" parent="1" source="d_main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" target="d_board">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_board_basic" edge="1" parent="1" source="d_board" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" target="d_basic_bsp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_basic_checked" edge="1" parent="1" source="d_basic_bsp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" target="d_checked_bsp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_checked_result" edge="1" parent="1" source="d_checked_bsp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;endArrow=classic;" target="d_init_result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_loop_gate" edge="1" parent="1" source="d_loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;" target="d_time_gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_gate_mark" edge="1" parent="1" source="d_time_gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" target="d_sample_mark" value="到期">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_mark_collect" edge="1" parent="1" source="d_sample_mark" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" target="d_collect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_collect_model" edge="1" parent="1" source="d_collect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" target="d_model">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_model_fanout" edge="1" parent="1" source="d_model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=classic;" target="d_fanout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_fanout_storage" edge="1" parent="1" source="d_fanout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;endArrow=classic;" target="d_storage" value="当前">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_fanout_tcp" edge="1" parent="1" source="d_fanout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;dashed=1;endArrow=classic;" target="d_tcp_protocol" value="待接入">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_tcp_output" edge="1" parent="1" source="d_tcp_protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;dashed=1;endArrow=classic;" target="d_tcp_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_fanout_can" edge="1" parent="1" source="d_fanout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;dashed=1;endArrow=classic;" target="d_can_protocol" value="待接入">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_can_output" edge="1" parent="1" source="d_can_protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;" target="d_can_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_storage_slot" edge="1" parent="1" source="d_storage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" target="d_slot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_slot_write" edge="1" parent="1" source="d_slot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" target="d_write_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_write_power" edge="1" parent="1" source="d_write_order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;" target="d_power_loss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de_power_capacity" edge="1" parent="1" source="d_power_loss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;" target="d_capacity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="edgenode-files-calls" name="文件与调用关系">
    <mxGraphModel dx="1900" dy="1350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1400" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f_title" value="EdgeNode 文件层级与函数调用关系：BOARD → BSP → APP" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="470" y="20" width="1000" height="45" as="geometry" />
        </mxCell>
        <mxCell id="f_legend" value="&lt;b&gt;箭头含义&lt;/b&gt;&#xa;实线：当前直接函数调用&#xa;虚线：中断、DMA 或待接入调用&#xa;绿色：当前运行主链&#xa;蓝色：共享资源&#xa;黄色：已有支路&#xa;红色：接收或功能缺口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#374151;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1650" y="20" width="280" height="125" as="geometry" />
        </mxCell>
        <mxCell id="f_tree_group" value="1. 工程文件树：文件应该放在哪里" style="swimlane;startSize=34;rounded=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="420" height="1220" as="geometry" />
        </mxCell>
        <mxCell id="f_tree" value="&lt;b&gt;edgenode/&lt;/b&gt;&lt;br&gt;├─ Drivers/&lt;br&gt;│  ├─ BOARD/&lt;br&gt;│  │  ├─ board_config.c：全板公共策略&lt;br&gt;│  │  ├─ board_time.c：SysTick 与 delay_ms&lt;br&gt;│  │  └─ spi0_bus.c：共享 SPI0 总线&lt;br&gt;│  ├─ BSP/&lt;br&gt;│  │  ├─ BMP280/：传感器寄存器协议&lt;br&gt;│  │  ├─ GD25Q32/：Flash 命令与页写&lt;br&gt;│  │  ├─ CAN/：CAN0 初始化和原始帧发送&lt;br&gt;│  │  ├─ ESP12S/：USART1 AT 字节发送&lt;br&gt;│  │  ├─ IPS/：ST7789、SPI2、DMA&lt;br&gt;│  │  ├─ CH340、LED、KEY、ADC/&lt;br&gt;│  │  └─ INTERRUPT/：USART、CAN、EXTI ISR&lt;br&gt;│  └─ GD32 标准外设库&lt;br&gt;├─ User/&lt;br&gt;│  ├─ main.c：启动与循环调度&lt;br&gt;│  └─ App/&lt;br&gt;│     ├─ Config：稳定策略&lt;br&gt;│     ├─ Startup：初始化编排&lt;br&gt;│     ├─ Acquisition：采样封装&lt;br&gt;│     ├─ Model：统一 Message&lt;br&gt;│     ├─ Protocol：帧与 CRC&lt;br&gt;│     ├─ Output：外部副作用&lt;br&gt;│     ├─ Service：一次采样调度&lt;br&gt;│     └─ Presentation：显示缓冲与 HMI&lt;br&gt;└─ ThirdParty/：第三方渲染库" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#1F2937;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="140" width="370" height="1120" as="geometry" />
        </mxCell>
        <mxCell id="f_start_group" value="2. 当前主调用链：从 main 到一次 Flash 记录" style="swimlane;startSize=34;rounded=1;fillColor=#E8F5E9;strokeColor=#82B366;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1">
          <mxGeometry x="465" y="90" width="810" height="650" as="geometry" />
        </mxCell>
        <mxCell id="f_main" value="&lt;b&gt;User/main.c&lt;/b&gt;&#xa;main()&#xa;init_all()&#xa;while(1) → node_service_run_once()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="155" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f_startup" value="&lt;b&gt;App/Startup/init.c&lt;/b&gt;&#xa;init_all()&#xa;按依赖顺序初始化&#xa;失败即返回 INIT_ALL_FAIL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="730" y="150" width="190" height="105" as="geometry" />
        </mxCell>
        <mxCell id="f_service" value="&lt;b&gt;App/Service/node_service.c&lt;/b&gt;&#xa;node_service_run_once()&#xa;以 SysTick 进行 1000 ms 节流&#xa;当前只扇出 Storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="970" y="150" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f_message" value="&lt;b&gt;App/Model/message.c&lt;/b&gt;&#xa;message_collect()&#xa;把采样结果装入 telemetry_sample_struct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="520" y="370" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f_collection" value="&lt;b&gt;App/Acquisition/collection.c&lt;/b&gt;&#xa;collection_temperature_get()&#xa;bmp280_temperature_get()&#xa;写入 sample_uptime_ms 与倍率 -2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="780" y="350" width="235" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f_storage" value="&lt;b&gt;App/Output/Storage/storage.c&lt;/b&gt;&#xa;storage_init()：选择全空扇区&#xa;storage_temperature()：编码、写入、提交、读回验证&#xa;storage_next_address_get()：只读调试地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1050" y="340" width="200" height="145" as="geometry" />
        </mxCell>
        <mxCell id="f_crc" value="&lt;b&gt;App/Protocol/CRC/crc.c&lt;/b&gt;&#xa;crc32_generate()&#xa;crc32_check()&#xa;Storage 与 TCP 复用同一实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="590" y="555" width="215" height="95" as="geometry" />
        </mxCell>
        <mxCell id="f_board_group" value="3. BOARD：共享资源只初始化一次" style="swimlane;startSize=34;rounded=1;fillColor=#E8F4F8;strokeColor=#6C8EBF;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1">
          <mxGeometry x="1300" y="90" width="630" height="650" as="geometry" />
        </mxCell>
        <mxCell id="f_board_config" value="&lt;b&gt;Drivers/BOARD/board_config.c&lt;/b&gt;&#xa;board_config_init()&#xa;board_nvic_config()&#xa;board_debug_config()&#xa;board_clock_config()&#xa;board_systick_config()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1335" y="150" width="245" height="150" as="geometry" />
        </mxCell>
        <mxCell id="f_time" value="&lt;b&gt;Drivers/BOARD/board_time.c&lt;/b&gt;&#xa;SysTick_Handler()：每 1 ms 递增&#xa;board_systick_ms&#xa;delay_ms()：忙等辅助" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1630" y="150" width="260" height="115" as="geometry" />
        </mxCell>
        <mxCell id="f_spi0" value="&lt;b&gt;Drivers/BOARD/spi0_bus.c&lt;/b&gt;&#xa;spi0_bus_init()&#xa;spi0_tansfer_data()&#xa;spi0_bus_wait_idle()&#xa;带毫秒超时与轮询上限&#xa;故障后锁定，显式重初始化才恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1450" y="380" width="300" height="155" as="geometry" />
        </mxCell>
        <mxCell id="f_shared_rule" value="共享规则&#xa;PA5 SCK、PA6 MISO、PA7 MOSI&#xa;BOARD 拥有总线配置&#xa;BMP280 与 GD25Q32 只拥有各自 CS 与设备协议" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1350" y="590" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f_bsp_group" value="4. BSP：设备本地协议与硬件操作" style="swimlane;startSize=34;rounded=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1">
          <mxGeometry x="465" y="780" width="1465" height="530" as="geometry" />
        </mxCell>
        <mxCell id="f_bmp" value="&lt;b&gt;BSP/BMP280/bmp280.c&lt;/b&gt;&#xa;bmp280_init()&#xa;读 CHIP_ID、校准参数、配置寄存器&#xa;bmp280_temperature_get()&#xa;设备读写 → spi0_tansfer_data()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="500" y="850" width="255" height="135" as="geometry" />
        </mxCell>
        <mxCell id="f_gd25" value="&lt;b&gt;BSP/GD25Q32/gd25.c&lt;/b&gt;&#xa;gd25_init()：读取 JEDEC ID&#xa;gd25_read()、gd25_write()、gd25_clear()&#xa;写使能、忙等待、页边界约束&#xa;设备读写 → spi0_tansfer_data()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="800" y="835" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="f_can" value="&lt;b&gt;BSP/CAN/can.c&lt;/b&gt;&#xa;Can_init()：PB8 PB9 重映射、500 kbit/s、FIFO 中断&#xa;can0_data_send()：只收标准 ID 与原始最多 8 字节&#xa;邮箱分配成功不等于远端收到" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1130" y="835" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="f_esp" value="&lt;b&gt;BSP/ESP12S/esp12s.c&lt;/b&gt;&#xa;esp12s_init()：配置 USART1&#xa;esp12s_cmd_send()：发送 AT 命令字节&#xa;实际 AT 回应由 USART1 中断解析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1470" y="850" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="f_ips" value="&lt;b&gt;BSP/IPS/ips.c&lt;/b&gt;&#xa;ips_init()：SPI2、DMA、ST7789 控制脚&#xa;ips_flush_line()：提交一行像素&#xa;由 Presentation/Buffer 调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="1740" y="850" width="160" height="125" as="geometry" />
        </mxCell>
        <mxCell id="f_support" value="&lt;b&gt;其余本地 BSP&lt;/b&gt;&#xa;CH340：USART0 与 fputc&#xa;LED：GPIO 开关与翻转&#xa;KEY：GPIO 与 EXTI&#xa;ADC：ADC 配置与 adc_data_get()&#xa;这些模块不应了解 Message、Flash 或协议字段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="550" y="1080" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="f_irq" value="&lt;b&gt;BSP/INTERRUPT：硬件异步入口&lt;/b&gt;&#xa;USART1_IRQHandler()：把完整 AT 回应放入队列&#xa;esp12s_response_get()：TCP 层轮询取事件&#xa;USBD_LP_CAN0_RX0_IRQHandler()：仅把 FIFO0 收到的帧存入静态变量&#xa;当前尚无 APP 层 CAN 接收消费接口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="950" y="1080" width="530" height="140" as="geometry" />
        </mxCell>
        <mxCell id="f_protocol" value="&lt;b&gt;APP 协议与输出支路&lt;/b&gt;&#xa;Protocol/Tcp/tcp_frame_encode()：Message → 16 字节 TCP V4&#xa;Protocol/Can/can_frame_encode()：Message → 7 字节 CAN 负载&#xa;Output/Can/can_telemetry_send()：编码后调用 can0_data_send()&#xa;Output/Tcp/tcp_init()：调用 esp12s_init() 与 AT 等待流程&#xa;Service 尚未接入 TCP 与 CAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="1530" y="1060" width="360" height="165" as="geometry" />
        </mxCell>
