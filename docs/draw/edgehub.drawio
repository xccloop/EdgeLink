        <mxCell id="e_tcp_epoll" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;" edge="1" source="tcp_init" target="epoll_init" parent="init_group">
          <mxGeometry relative="1" as="geometry" />
