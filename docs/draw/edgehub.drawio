        <mxCell id="e_tcp_event_recv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=classic;" edge="1" source="tcp_event" target="recv_loop" parent="1">
          <mxGeometry relative="1" as="geometry" />
