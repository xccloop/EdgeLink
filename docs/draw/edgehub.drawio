<mxfile host="Electron" pages="3">
  <diagram id="edgehub-flow" name="流程思维导图">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="EdgeHub（Raspberry Pi / C++）流程思维导图" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="630" y="20" width="680" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;图例&lt;/b&gt;&#xa;蓝色：事件驱动 / 传输&#xa;绿色：校验后数据主链&#xa;黄色：条件或保留状态&#xa;红色：错误 / 当前风险&#xa;虚线：异常或未闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#374151;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="40" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="center" value="&lt;b&gt;EdgeHub&lt;/b&gt;&#xa;单线程 epoll ET&#xa;TCP + CAN 遥测接入" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="500" width="200" height="200" as="geometry" />
        </mxCell>
        <mxCell id="init_group" value="1. 进程启动与资源注册" style="swimlane;startSize=32;rounded=1;fillColor=#E8F4F8;strokeColor=#6C8EBF;fontStyle=1;fontSize=15;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="760" height="330" as="geometry" />
        </mxCell>
        <mxCell id="objects" value="创建对象&#xa;TcpServe / Can / Epoll / Storage&#xa;clients[] / fd_table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="init_group">
          <mxGeometry x="30" y="55" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="can_init" value="CAN 初始化&#xa;绑定 can0&#xa;设置非阻塞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="init_group">
          <mxGeometry x="265" y="60" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tcp_init" value="TCP 服务端初始化&#xa;端口 8888 / backlog 10&#xa;设置非阻塞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="init_group">
          <mxGeometry x="455" y="55" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="epoll_init" value="创建 epoll&#xa;注册 listen_fd + can_fd&#xa;EPOLLIN | EPOLLET" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="init_group">
          <mxGeometry x="575" y="190" width="160" height="85" as="geometry" />
        </mxCell>
        <mxCell id="db_init" value="SQLite 初始化&#xa;open() + CREATE TABLE&#xa;messages（STRICT）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="init_group">
          <mxGeometry x="330" y="190" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="init_fail" value="任一步失败&#xa;main 返回 -1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="init_group">
          <mxGeometry x="80" y="200" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="event_group" value="2. epoll ET 事件分发" style="swimlane;startSize=32;rounded=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontStyle=1;fontSize=15;html=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="220" width="700" height="420" as="geometry" />
        </mxCell>
        <mxCell id="epoll_wait" value="epoll_wait()&#xa;等待就绪 fd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="event_group">
          <mxGeometry x="30" y="55" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fd_lookup" value="fd_table 查找类型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="event_group">
          <mxGeometry x="220" y="60" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" value="FdType？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="event_group">
          <mxGeometry x="415" y="50" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="listen_event" value="Tcpserve&#xa;accept 到 EAGAIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="event_group">
          <mxGeometry x="40" y="185" width="155" height="70" as="geometry" />
        </mxCell>
        <mxCell id="client_register" value="分配 ClientState&#xa;每连接独立 Ringbuffer&#xa;非阻塞 + 加入 epoll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="event_group">
          <mxGeometry x="235" y="175" width="175" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tcp_event" value="Tcpclient&#xa;处理可读 / 关闭 / 错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="event_group">
          <mxGeometry x="455" y="180" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="can_event" value="Can&#xa;读取到 EAGAIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="event_group">
          <mxGeometry x="265" y="315" width="155" height="65" as="geometry" />
        </mxCell>
        <mxCell id="eintr" value="EINTR：继续等待&#xa;其他 epoll 错误：退出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="event_group">
          <mxGeometry x="485" y="310" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="tcp_group" value="3A. TCP V4 字节流 → Message" style="swimlane;startSize=32;rounded=1;fillColor=#E8F4F8;strokeColor=#6C8EBF;fontStyle=1;fontSize=15;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="730" height="470" as="geometry" />
        </mxCell>
        <mxCell id="recv_loop" value="recv 循环&#xa;一直读取到 EAGAIN&#xa;仅写入实际收到字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="tcp_group">
          <mxGeometry x="30" y="55" width="165" height="85" as="geometry" />
        </mxCell>
        <mxCell id="ringbuffer" value="当前客户端 Ringbuffer&#xa;保留半包 / 承接粘包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="tcp_group">
          <mxGeometry x="235" y="60" width="175" height="75" as="geometry" />
        </mxCell>
        <mxCell id="parser" value="tcp_frame_parser()&#xa;搜 Magic 0x45 0x48&#xa;校验 V4 / 节点 / CRC32&#xa;固定 16 字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="tcp_group">
          <mxGeometry x="455" y="45" width="190" height="105" as="geometry" />
        </mxCell>
        <mxCell id="parse_result" value="解析结果？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="tcp_group">
          <mxGeometry x="285" y="195" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="PENDING&#xa;保留半帧&#xa;等待下一次 EPOLLIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="tcp_group">
          <mxGeometry x="30" y="205" width="160" height="75" as="geometry" />
        </mxCell>
        <mxCell id="tcp_message" value="SUCCESS&#xa;Message_handle()&#xa;TcpFrame → Message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="tcp_group">
          <mxGeometry x="485" y="200" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cleanup" value="ERROR / EOF / HUP / RDHUP&#xa;epoll.del → fd_table.erase&#xa;ClientState reset 关闭连接" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="tcp_group">
          <mxGeometry x="235" y="330" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="can_group" value="3B. CAN 帧 → Message" style="swimlane;startSize=32;rounded=1;fillColor=#E8F5E9;strokeColor=#82B366;fontStyle=1;fontSize=15;html=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="720" width="700" height="350" as="geometry" />
        </mxCell>
        <mxCell id="can_read" value="SocketCAN read()&#xa;ET 模式读到 EAGAIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="can_group">
          <mxGeometry x="30" y="60" width="165" height="75" as="geometry" />
        </mxCell>
        <mxCell id="can_validate" value="校验 CAN 遥测格式&#xa;标准数据帧&#xa;DLC = 7&#xa;ID 0x201 ~ 0x27F" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="can_group">
          <mxGeometry x="240" y="50" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="can_message" value="构造统一 Message&#xa;nodeId / sequence&#xa;temperature / scale&#xa;receivedAtUs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="can_group">
          <mxGeometry x="455" y="50" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="can_drop" value="格式不符：丢弃&#xa;读取错误：结束本轮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="can_group">
          <mxGeometry x="250" y="210" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="storage_group" value="4. 统一存储出口" style="swimlane;startSize=32;rounded=1;fillColor=#E8F5E9;strokeColor=#82B366;fontStyle=1;fontSize=15;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="790" width="390" height="300" as="geometry" />
        </mxCell>
        <mxCell id="shared_message" value="Message&#xa;nodeId / sequence&#xa;temperature / scale&#xa;receivedAtUs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="storage_group">
          <mxGeometry x="35" y="60" width="150" height="100" as="geometry" />
        </mxCell>
        <mxCell id="insert" value="Storage::insertMessage()&#xa;预编译 SQL + bind" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="storage_group">
          <mxGeometry x="215" y="70" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="database" value="messages 表&#xa;SQLite 数据库" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="storage_group">
          <mxGeometry x="145" y="195" width="110" height="75" as="geometry" />
        </mxCell>
        <mxCell id="risk" value="当前实现注意点&#xa;数据库路径硬编码为 Mini_Edgehub&#xa;同步逐帧写入 epoll 主线程&#xa;g_running 尚未接入 while 条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#7F1D1D;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="1140" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e_center_init" value="初始化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=classic;" edge="1" source="center" target="objects" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_objects_can" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;" edge="1" source="objects" target="can_init" parent="init_group">
          <mxGeometry relative="1" as="geometry" />
