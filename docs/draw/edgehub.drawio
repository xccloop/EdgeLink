  <diagram id="xI9Wc0vOiQhWVQDwcFeq" name="APP 业务到系统树">
    <mxGraphModel dx="-2038" dy="-547" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="EdgeHub 核心业务&#xa;接收节点遥测 → 校验 → 统一消息 → SQLite 持久化" mermaidId="n:ROOT" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontColor=#1e3d1e;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="EdgeHub 核心业务&#xa;接收节点遥测 → 校验 → 统一消息 → SQLite 持久化" id="2">
          <mxCell parent="1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontColor=#1e3d1e;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="73" width="428" x="2945" y="38" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="启动业务：进程启动时只执行一次" mermaidId="n:BOOT" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontColor=#1e3d1e;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="启动业务：进程启动时只执行一次" id="3">
          <mxCell parent="1" style="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontColor=#1e3d1e;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="54" width="300" x="1061" y="161" as="geometry" />
