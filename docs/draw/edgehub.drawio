        <mxCell id="e_epoll_db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" edge="1" source="epoll_init" target="db_init" parent="init_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_init_fail" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;dashed=1;endArrow=classic;" edge="1" source="objects" target="init_fail" parent="init_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_center_wait" value="事件循环" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=classic;" edge="1" source="center" target="epoll_wait" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_wait_lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;" edge="1" source="epoll_wait" target="fd_lookup" parent="event_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_lookup_dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;" edge="1" source="fd_lookup" target="dispatch" parent="event_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dispatch_listen" value="监听 fd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;" edge="1" source="dispatch" target="listen_event" parent="event_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_listen_register" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;" edge="1" source="listen_event" target="client_register" parent="event_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dispatch_tcp" value="客户端 fd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;" edge="1" source="dispatch" target="tcp_event" parent="event_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dispatch_can" value="can_fd" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;" edge="1" source="dispatch" target="can_event" parent="event_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_wait_eintr" value="错误" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;dashed=1;endArrow=classic;" edge="1" source="epoll_wait" target="eintr" parent="event_group">
          <mxGeometry relative="1" as="geometry" />
