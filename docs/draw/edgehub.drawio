        <mxCell id="e_recv_ring" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;" edge="1" source="recv_loop" target="ringbuffer" parent="tcp_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ring_parser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" edge="1" source="ringbuffer" target="parser" parent="tcp_group">
