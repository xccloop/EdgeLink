        <mxCell id="e_can_read_validate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;" edge="1" source="can_read" target="can_validate" parent="can_group">
          <mxGeometry relative="1" as="geometry" />
