        <mxCell id="e_parser_result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" edge="1" source="parser" target="parse_result" parent="tcp_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_result_pending" value="PENDING" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D6B656;endArrow=classic;" edge="1" source="parse_result" target="pending" parent="tcp_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_result_success" value="SUCCESS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;endArrow=classic;" edge="1" source="parse_result" target="tcp_message" parent="tcp_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_result_error" value="ERROR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B85450;dashed=1;endArrow=classic;" edge="1" source="parse_result" target="cleanup" parent="tcp_group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_can_event_read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=classic;" edge="1" source="can_event" target="can_read" parent="1">
