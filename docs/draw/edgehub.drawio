        <mxCell id="e_can_tcp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;endArrow=classic;" edge="1" source="can_init" target="tcp_init" parent="init_group">
          <mxGeometry relative="1" as="geometry" />
